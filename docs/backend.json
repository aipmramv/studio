{
  "entities": {
    "UserProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserProfile",
      "type": "object",
      "description": "Represents a user in the TrackFlow system.",
      "properties": {
        "id": { "type": "string", "description": "Unique identifier for the UserProfile entity." },
        "email": { "type": "string", "description": "User's email address.", "format": "email" },
        "role": { "type": "string", "description": "User's role within the system." },
        "displayName": { "type": "string", "description": "User's display name." },
        "department": { "type": "string", "description": "User's department." }
      },
      "required": ["id", "email", "role"]
    },
    "Asset": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Asset",
      "type": "object",
      "description": "Represents a physical asset in the KTI Asset Management System.",
      "properties": {
        "assetNumber": { "type": "string" },
        "kmNumber": { "type": "string" },
        "assetDescription": { "type": "string" },
        "assetClassification": { "type": "string" },
        "assetGrouping": { "type": "string" },
        "lifecycleYears": { "type": "number" },
        "capitalizationDate": { "type": "string", "format": "date-time" },
        "eolDate": { "type": "string", "format": "date-time" },
        "purchaseValue": { "type": "number" },
        "ledgerQty": { "type": "number" },
        "brandName": { "type": "string" },
        "modelNo": { "type": "string" },
        "productSerialNo": { "type": "string" },
        "onGoingProject": { "type": "string" },
        "weeklyUsageFrequency": { "type": "number" },
        "personResponsible": { "type": "string" },
        "currentUser": { "type": "string" },
        "teamOrTribe": { "type": "string" },
        "department": { "type": "string" },
        "assetCoordinator": { "type": "string" },
        "location": { "type": "string" },
        "floor": { "type": "string" },
        "laboratory": { "type": "string" },
        "verificationStatus": { "type": "string" },
        "verifiedOn": { "type": "string", "format": "date-time" },
        "usableCondition": { "type": "string" },
        "workingConditionStatus": { "type": "string" },
        "comments": { "type": "string" },
        "currentStatus": { "type": "string" },
        "statusChangedOn": { "type": "string", "format": "date-time" }
      },
      "required": ["assetNumber", "assetDescription", "department", "location"]
    },
    "AssetRequest": {
        "title": "AssetRequest",
        "type": "object",
        "description": "Represents a request for asset ownership change.",
        "properties": {
            "assets": { "type": "array", "items": { "type": "object", "properties": { "assetId": { "type": "string" }, "assetNumber": { "type": "string" } } } },
            "fromDepartment": { "type": "string" },
            "toDepartment": { "type": "string" },
            "reason": { "type": "string" },
            "requestedBy": { "type": "string" },
            "requestedOn": { "type": "string", "format": "date-time" },
            "status": { "type": "string", "enum": ["Pending", "Approved", "Rejected"] }
        },
        "required": ["assets", "fromDepartment", "toDepartment", "reason", "requestedBy", "requestedOn", "status"]
    },
    "AssetTransfer": {
        "title": "AssetTransfer",
        "type": "object",
        "description": "Represents the physical transfer of an asset.",
        "properties": {
            "assetId": { "type": "string" },
            "assetNumber": { "type": "string" },
            "fromLocation": { "type": "string" },
            "toLocation": { "type": "string" },
            "movementType": { "type": "string" },
            "dcNumber": { "type": "string" },
            "dispatchDate": { "type": "string", "format": "date-time" },
            "responsiblePerson": { "type": "string" },
            "reason": { "type": "string" }
        },
        "required": ["assetId", "assetNumber", "fromLocation", "toLocation", "movementType", "dcNumber", "dispatchDate", "responsiblePerson"]
    },
    "AssetVerification": {
        "title": "AssetVerification",
        "type": "object",
        "description": "Represents a verification/audit record for an asset.",
        "properties": {
            "assetId": { "type": "string" },
            "assetNumber": { "type": "string" },
            "verificationStatus": { "type": "string" },
            "usableCondition": { "type": "string" },
            "workingCondition": { "type": "string" },
            "comments": { "type": "string" },
            "verifiedBy": { "type": "string" },
            "verifiedOn": { "type": "string", "format": "date-time" }
        },
        "required": ["assetId", "assetNumber", "verificationStatus", "verifiedBy", "verifiedOn"]
    },
     "AssetCheckout": {
        "title": "AssetCheckout",
        "type": "object",
        "description": "Represents a check-in/check-out record for an asset.",
        "properties": {
            "assetId": { "type": "string" },
            "assetNumber": { "type": "string" },
            "custodian": { "type": "string" },
            "checkedOutOn": { "type": "string", "format": "date-time" },
            "expectedReturnDate": { "type": "string", "format": "date-time" },
            "remarks": { "type": "string" },
            "status": { "type": "string", "enum": ["Checked-out", "Checked-in"] }
        },
        "required": ["assetId", "assetNumber", "custodian", "checkedOutOn", "expectedReturnDate", "status"]
    },
    "ScrapRecord": {
        "title": "ScrapRecord",
        "type": "object",
        "description": "Represents the record of a scrapped asset.",
        "properties": {
            "assetId": { "type": "string" },
            "assetNumber": { "type": "string" },
            "scrapDcNo": { "type": "string" },
            "scrapDcDate": { "type": "string", "format": "date-time" },
            "reason": { "type": "string" }
        },
        "required": ["assetId", "assetNumber", "scrapDcNo", "scrapDcDate"]
    },
    "AssetFeedback": {
        "title": "AssetFeedback",
        "type": "object",
        "description": "Represents feedback or an issue log for an asset.",
        "properties": {
            "assetId": { "type": "string" },
            "assetNumber": { "type": "string" },
            "category": { "type": "string" },
            "details": { "type": "string" },
            "submittedBy": { "type": "string" },
            "submittedOn": { "type": "string", "format": "date-time" },
            "status": { "type": "string", "enum": ["Open", "In Progress", "Resolved"] }
        },
        "required": ["assetId", "assetNumber", "category", "details", "submittedBy", "submittedOn", "status"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "collections": [
      {
        "path": "/users/{userId}",
        "schema": { "$ref": "#/entities/UserProfile" },
        "description": "Stores user profile information."
      },
      {
        "path": "/assets/{assetId}",
        "schema": { "$ref": "#/entities/Asset" },
        "description": "Stores all asset master data."
      },
      {
        "path": "/assetRequests/{requestId}",
        "schema": { "$ref": "#/entities/AssetRequest" },
        "description": "Stores asset ownership change requests."
      },
      {
        "path": "/assetTransfers/{transferId}",
        "schema": { "$ref": "#/entities/AssetTransfer" },
        "description": "Stores asset transfer/movement logs."
      },
      {
        "path": "/assetVerifications/{verificationId}",
        "schema": { "$ref": "#/entities/AssetVerification" },
        "description": "Stores asset verification history."
      },
       {
        "path": "/assetCheckouts/{checkoutId}",
        "schema": { "$ref": "#/entities/AssetCheckout" },
        "description": "Stores asset check-in/check-out history."
      },
      {
        "path": "/scrapRecords/{scrapId}",
        "schema": { "$ref": "#/entities/ScrapRecord" },
        "description": "Stores records of scrapped assets."
      },
      {
        "path": "/assetFeedback/{feedbackId}",
        "schema": { "$ref": "#/entities/AssetFeedback" },
        "description": "Stores feedback and issue logs for assets."
      }
    ]
  }
}