/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System
 *
 * Core Philosophy:
 * This ruleset prioritizes strong authorization based on user identity and ownership.
 * It avoids complex data validation to enable rapid prototyping and schema evolution.
 *
 * Data Structure:
 * - User profiles are stored in `/users/{userId}`.
 * - Assets are stored in `/assets/{assetId}`.
 * - Asset Requests are stored in `/assetRequests/{requestId}`.
 * - Asset Transfers are stored in `/assetTransfers/{transferId}`.
 * - Asset Verifications are stored in `/assetVerifications/{verificationId}`.
 * - Asset Checkouts are stored in `/assetCheckouts/{checkoutId}`.
 * - Scrap Records are stored in `/scrapRecords/{scrapId}`.
 * - Asset Feedback is stored in `/assetFeedback/{feedbackId}`.
 *
 * Key Security Decisions:
 * - Users can only read and write their own user profile data.
 * - Public read access is granted for assets, but writes are restricted (owner-only).
 *   The `assets` collection requires an ownership field to secure writes.
 * - All other collections (assetRequests, assetTransfers, assetVerifications, assetCheckouts, scrapRecords, assetFeedback) are writeable by any authenticated user.
 * - Listing of `/users` is denied for security reasons.
 *
 * Denormalization for Authorization:
 * - The rules assume that documents in the `/assets` collection contain an `ownerId` or `authorId` field.
 *   This field is used to verify ownership for write operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile data.
     * @path /users/{userId}
     * @allow (create) User 'ramv@gmail.com' (uid: 'swli0WsZWiWITLv606cnK9rJLUk2') can create their own profile.
     * @allow (get, update, delete) User 'ramv@gmail.com' (uid: 'swli0WsZWiWITLv606cnK9rJLUk2') can read, update, and delete their own profile.
     * @deny (create) User 'john.doe@example.com' (uid: 'differentUID') cannot create a profile with another user's ID.
     * @deny (update, delete) User 'john.doe@example.com' (uid: 'differentUID') cannot update or delete another user's profile.
     * @deny (list) Listing all users is prohibited.
     * @principle Enforces user-ownership for profile data and prevents listing all users.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to asset data.
     * @path /assets/{assetId}
     * @allow (get, list) Any user can read asset data.
     * @allow (create) User 'ramv@gmail.com' (uid: 'swli0WsZWiWITLv606cnK9rJLUk2') can create an asset if they are the owner.
     * @allow (update, delete) User 'ramv@gmail.com' (uid: 'swli0WsZWiWITLv606cnK9rJLUk2') can update or delete an asset if they are the owner and it exists.
     * @deny (create) User 'john.doe@example.com' (uid: 'differentUID') cannot create an asset with another user as the owner.
     * @deny (update, delete) User 'john.doe@example.com' (uid: 'differentUID') cannot update or delete an asset they don't own.
     * @principle Allows public read access but restricts writes to the asset owner.
     */
    match /assets/{assetId} {
      allow get, list: if true;
      allow create: if isSignedIn() && request.resource.data.authorId == request.auth.uid; //Validate ownership on create
      allow update: if isSignedIn() && isExistingOwner(resource.data.authorId); // Validate existing ownership on update
      allow delete: if isSignedIn() && isExistingOwner(resource.data.authorId); // Validate existing ownership on delete
    }

    /**
     * @description Controls access to asset requests data.
     * @path /assetRequests/{requestId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation on asset requests.
     * @principle Allows any signed-in user to manage asset requests.
     */
    match /assetRequests/{requestId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Controls access to asset transfers data.
     * @path /assetTransfers/{transferId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation on asset transfers.
     * @principle Allows any signed-in user to manage asset transfers.
     */
    match /assetTransfers/{transferId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Controls access to asset verifications data.
     * @path /assetVerifications/{verificationId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation on asset verifications.
     * @principle Allows any signed-in user to manage asset verifications.
     */
    match /assetVerifications/{verificationId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

     /**
     * @description Controls access to asset checkouts data.
     * @path /assetCheckouts/{checkoutId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation on asset checkouts.
     * @principle Allows any signed-in user to manage asset checkouts.
     */
    match /assetCheckouts/{checkoutId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Controls access to scrap records data.
     * @path /scrapRecords/{scrapId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation on scrap records.
     * @principle Allows any signed-in user to manage scrap records.
     */
    match /scrapRecords/{scrapId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    /**
     * @description Controls access to asset feedback data.
     * @path /assetFeedback/{feedbackId}
     * @allow (get, list, create, update, delete) Any authenticated user can perform any operation on asset feedback.
     * @principle Allows any signed-in user to manage asset feedback.
     */
    match /assetFeedback/{feedbackId} {
      allow get, list, create, update, delete: if isSignedIn();
    }
  }

  // Helper Functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}