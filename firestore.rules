/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles
 * and open read access for asset-related data, with owner-only write access.
 *
 * Data Structure:
 * - User profiles are stored under /users/{userId}.
 * - Assets and their related data (requests, transfers, verifications, checkouts, scrap records, feedback)
 *   are stored in top-level collections: /assets/{assetId}, /assetRequests/{requestId}, etc.
 *
 * Key Security Decisions:
 * - Users can only read/write their own profile data.
 * - Listing of users is disallowed.
 * - Assets and related data are readable by anyone, but can only be created, updated, or deleted by
 *   an identified owner. Each of the documents related to Assets contains an 'assetNumber' or 'assetId' which
 *   can be used to link it to the Assets collection.
 *
 * Denormalization for Authorization:
 *  All data related to assets will be readable. Since we have no ownership pattern for these documents
 *  we will need to add one to the schema.
 *
 * Structural Segregation:
 *  There is no segregation between public and private collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile data.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     * @allow (get) User with ID 'user123' can read their profile.
     * @allow (update) User with ID 'user123' can update their profile.
     * @allow (delete) User with ID 'user123' can delete their profile.
     * @deny (create) User with ID 'user123' cannot create another user's profile.
     * @deny (get) User with ID 'user123' cannot read another user's profile.
     * @deny (update) User with ID 'user123' cannot update another user's profile.
     * @deny (delete) User with ID 'user123' cannot delete another user's profile.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages asset master data.
     * @path /assets/{assetId}
     * @allow (get) Any user can retrieve asset data.
     * @allow (list) Any user can list asset data.
     * @deny (create) No user can create asset data without proper authorization.
     * @deny (update) No user can update asset data without proper authorization.
     * @deny (delete) No user can delete asset data without proper authorization.
     * @principle Allows public read access but restricts writes to owners.
     */
    match /assets/{assetId} {
      allow get, list: if true;
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

     /**
      * @description Manages asset ownership change requests.
      * @path /assetRequests/{requestId}
      * @allow (get) Any user can retrieve asset request data.
      * @allow (list) Any user can list asset request data.
      * @deny (create) No user can create asset request data without proper authorization.
      * @deny (update) No user can update asset request data without proper authorization.
      * @deny (delete) No user can delete asset request data without proper authorization.
      * @principle Allows public read access but restricts writes to owners.
      */
    match /assetRequests/{requestId} {
      allow get, list: if true;
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Manages asset transfer/movement logs.
     * @path /assetTransfers/{transferId}
     * @allow (get) Any user can retrieve asset transfer data.
     * @allow (list) Any user can list asset transfer data.
     * @deny (create) No user can create asset transfer data without proper authorization.
     * @deny (update) No user can update asset transfer data without proper authorization.
     * @deny (delete) No user can delete asset transfer data without proper authorization.
     * @principle Allows public read access but restricts writes to owners.
     */
    match /assetTransfers/{transferId} {
      allow get, list: if true;
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Manages asset verification history.
     * @path /assetVerifications/{verificationId}
     * @allow (get) Any user can retrieve asset verification data.
     * @allow (list) Any user can list asset verification data.
     * @deny (create) No user can create asset verification data without proper authorization.
     * @deny (update) No user can update asset verification data without proper authorization.
     * @deny (delete) No user can delete asset verification data without proper authorization.
     * @principle Allows public read access but restricts writes to owners.
     */
    match /assetVerifications/{verificationId} {
      allow get, list: if true;
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Manages asset check-in/check-out history.
     * @path /assetCheckouts/{checkoutId}
     * @allow (get) Any user can retrieve asset checkout data.
     * @allow (list) Any user can list asset checkout data.
     * @deny (create) No user can create asset checkout data without proper authorization.
     * @deny (update) No user can update asset checkout data without proper authorization.
     * @deny (delete) No user can delete asset checkout data without proper authorization.
     * @principle Allows public read access but restricts writes to owners.
     */
    match /assetCheckouts/{checkoutId} {
      allow get, list: if true;
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Manages records of scrapped assets.
     * @path /scrapRecords/{scrapId}
     * @allow (get) Any user can retrieve scrap record data.
     * @allow (list) Any user can list scrap record data.
     * @deny (create) No user can create scrap record data without proper authorization.
     * @deny (update) No user can update scrap record data without proper authorization.
     * @deny (delete) No user can delete scrap record data without proper authorization.
     * @principle Allows public read access but restricts writes to owners.
     */
    match /scrapRecords/{scrapId} {
      allow get, list: if true;
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }

    /**
     * @description Manages feedback and issue logs for assets.
     * @path /assetFeedback/{feedbackId}
     * @allow (get) Any user can retrieve asset feedback data.
     * @allow (list) Any user can list asset feedback data.
     * @deny (create) No user can create asset feedback data without proper authorization.
     * @deny (update) No user can update asset feedback data without proper authorization.
     * @deny (delete) No user can delete asset feedback data without proper authorization.
     * @principle Allows public read access but restricts writes to owners.
     */
    match /assetFeedback/{feedbackId} {
      allow get, list: if true;
      allow create: if request.resource.data.ownerId == request.auth.uid;
      allow update: if isExistingOwner(resource.data.ownerId);
      allow delete: if isExistingOwner(resource.data.ownerId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isExistingOwner(ownerId) {
    return isSignedIn() && request.auth.uid == ownerId && resource != null;
  }
}