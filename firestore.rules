/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System.
 *
 * Core Philosophy:
 * This ruleset enforces a flexible security model, granting all authenticated and email-verified users full read and write access to all data.
 *
 * Data Structure:
 * The Firestore database contains several top-level collections: `users`, `assets`, `assetRequests`, `assetTransfers`, `assetVerifications`, `assetCheckouts`, `scrapRecords`, and `assetFeedback`.
 *
 * Key Security Decisions:
 * - All read and write operations are allowed for users with verified emails to facilitate prototyping.
 * - No user listing is explicitly denied.
 *
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Grants all email-verified users full access to user profile information.
     * @path /users/{userId}
     * @allow (create, update, delete, get, list) - Any email-verified user.
     * @deny (none) - All email-verified users are allowed.
     * @principle Allows any email-verified user to read and write user profile information.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isEmailVerified();
      allow list: if isSignedIn() && isEmailVerified();
      allow create: if isSignedIn() && isEmailVerified();
      allow update: if isSignedIn() && isEmailVerified();
      allow delete: if isSignedIn() && isEmailVerified();
    }

    /**
     * @description Grants all email-verified users full access to asset master data.
     * @path /assets/{assetId}
     * @allow (create, update, delete, get, list) - Any email-verified user.
     * @deny (none) - All email-verified users are allowed.
     * @principle Allows any email-verified user to read and write asset master data.
     */
    match /assets/{assetId} {
      allow get: if isSignedIn() && isEmailVerified();
      allow list: if isSignedIn() && isEmailVerified();
      allow create: if isSignedIn() && isEmailVerified();
      allow update: if isSignedIn() && isEmailVerified();
      allow delete: if isSignedIn() && isEmailVerified();
    }

    /**
     * @description Grants all email-verified users full access to asset ownership change requests.
     * @path /assetRequests/{requestId}
     * @allow (create, update, delete, get, list) - Any email-verified user.
     * @deny (none) - All email-verified users are allowed.
     * @principle Allows any email-verified user to read and write asset ownership change requests.
     */
    match /assetRequests/{requestId} {
      allow get: if isSignedIn() && isEmailVerified();
      allow list: if isSignedIn() && isEmailVerified();
      allow create: if isSignedIn() && isEmailVerified();
      allow update: if isSignedIn() && isEmailVerified();
      allow delete: if isSignedIn() && isEmailVerified();
    }

    /**
     * @description Grants all email-verified users full access to asset transfer/movement logs.
     * @path /assetTransfers/{transferId}
     * @allow (create, update, delete, get, list) - Any email-verified user.
     * @deny (none) - All email-verified users are allowed.
     * @principle Allows any email-verified user to read and write asset transfer/movement logs.
     */
    match /assetTransfers/{transferId} {
      allow get: if isSignedIn() && isEmailVerified();
      allow list: if isSignedIn() && isEmailVerified();
      allow create: if isSignedIn() && isEmailVerified();
      allow update: if isSignedIn() && isEmailVerified();
      allow delete: if isSignedIn() && isEmailVerified();
    }

    /**
     * @description Grants all email-verified users full access to asset verification history.
     * @path /assetVerifications/{verificationId}
     * @allow (create, update, delete, get, list) - Any email-verified user.
     * @deny (none) - All email-verified users are allowed.
     * @principle Allows any email-verified user to read and write asset verification history.
     */
    match /assetVerifications/{verificationId} {
      allow get: if isSignedIn() && isEmailVerified();
      allow list: if isSignedIn() && isEmailVerified();
      allow create: if isSignedIn() && isEmailVerified();
      allow update: if isSignedIn() && isEmailVerified();
      allow delete: if isSignedIn() && isEmailVerified();
    }

    /**
     * @description Grants all email-verified users full access to asset check-in/check-out history.
     * @path /assetCheckouts/{checkoutId}
     * @allow (create, update, delete, get, list) - Any email-verified user.
     * @deny (none) - All email-verified users are allowed.
     * @principle Allows any email-verified user to read and write asset check-in/check-out history.
     */
    match /assetCheckouts/{checkoutId} {
      allow get: if isSignedIn() && isEmailVerified();
      allow list: if isSignedIn() && isEmailVerified();
      allow create: if isSignedIn() && isEmailVerified();
      allow update: if isSignedIn() && isEmailVerified();
      allow delete: if isSignedIn() && isEmailVerified();
    }

    /**
     * @description Grants all email-verified users full access to records of scrapped assets.
     * @path /scrapRecords/{scrapId}
     * @allow (create, update, delete, get, list) - Any email-verified user.
     * @deny (none) - All email-verified users are allowed.
     * @principle Allows any email-verified user to read and write records of scrapped assets.
     */
    match /scrapRecords/{scrapId} {
      allow get: if isSignedIn() && isEmailVerified();
      allow list: if isSignedIn() && isEmailVerified();
      allow create: if isSignedIn() && isEmailVerified();
      allow update: if isSignedIn() && isEmailVerified();
      allow delete: if isSignedIn() && isEmailVerified();
    }

    /**
     * @description Grants all email-verified users full access to feedback and issue logs for assets.
     * @path /assetFeedback/{feedbackId}
     * @allow (create, update, delete, get, list) - Any email-verified user.
     * @deny (none) - All email-verified users are allowed.
     * @principle Allows any email-verified user to read and write feedback and issue logs for assets.
     */
    match /assetFeedback/{feedbackId} {
      allow get: if isSignedIn() && isEmailVerified();
      allow list: if isSignedIn() && isEmailVerified();
      allow create: if isSignedIn() && isEmailVerified();
      allow update: if isSignedIn() && isEmailVerified();
      allow delete: if isSignedIn() && isEmailVerified();
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }
  }
}