/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles
 * and public-read/owner-write for assets and related collections. All other collections require authentication.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, secured by owner-only access.
 * - /assets/{assetId}: Stores asset master data, publicly readable but writable only by the user specified in the assets' fields.
 * - /assetRequests/{requestId}: Stores asset ownership change requests, publicly readable but writable only by the user specified in the asset request's fields.
 * - /assetTransfers/{transferId}: Stores asset transfer logs, publicly readable but writable only by the user specified in the asset transfer's fields.
 * - /assetVerifications/{verificationId}: Stores asset verification history, publicly readable but writable only by the user specified in the asset verification's fields.
 * - /assetCheckouts/{checkoutId}: Stores asset check-in/check-out history, publicly readable but writable only by the user specified in the asset checkout's fields.
 * - /scrapRecords/{scrapId}: Stores records of scrapped assets, publicly readable but writable only by the user specified in the scrap record's fields.
 * - /assetFeedback/{feedbackId}: Stores feedback and issue logs for assets, publicly readable but writable only by the user specified in the asset feedback's fields.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Default security posture for ambiguous relationships is strict owner-only access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profile information.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their own profile.
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     * @allow (get, list, update, delete) User with ID 'user123' can read, update, and delete their own profile.
     * @deny (get, list, update, delete) User with ID 'user456' cannot read, update, or delete 'user123' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages asset master data.
     * @path /assets/{assetId}
     * @allow (get, list) Any user can read asset data.
     * @allow (create) User can create an asset if they are the owner.
     * @deny (create) User cannot create an asset if they are not the owner.
     * @allow (update, delete) Only the owner can update or delete an asset.
     * @deny (update, delete) Other users cannot update or delete the asset.
     * @principle Allows public read access but restricts writes to the owner.
     */
    match /assets/{assetId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages asset ownership change requests.
     * @path /assetRequests/{requestId}
     * @allow (get, list) Any user can read asset requests.
     * @allow (create) User can create an asset request if they are the owner.
     * @deny (create) User cannot create an asset request if they are not the owner.
     * @allow (update, delete) Only the owner can update or delete an asset request.
     * @deny (update, delete) Other users cannot update or delete the asset request.
     * @principle Allows public read access but restricts writes to the owner.
     */
    match /assetRequests/{requestId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages asset transfer logs.
     * @path /assetTransfers/{transferId}
     * @allow (get, list) Any user can read asset transfer logs.
     * @allow (create) User can create an asset transfer log if they are the owner.
     * @deny (create) User cannot create an asset transfer log if they are not the owner.
     * @allow (update, delete) Only the owner can update or delete an asset transfer log.
     * @deny (update, delete) Other users cannot update or delete the asset transfer log.
     * @principle Allows public read access but restricts writes to the owner.
     */
    match /assetTransfers/{transferId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages asset verification history.
     * @path /assetVerifications/{verificationId}
     * @allow (get, list) Any user can read asset verification history.
     * @allow (create) User can create an asset verification record if they are the owner.
     * @deny (create) User cannot create an asset verification record if they are not the owner.
     * @allow (update, delete) Only the owner can update or delete an asset verification record.
     * @deny (update, delete) Other users cannot update or delete the asset verification record.
     * @principle Allows public read access but restricts writes to the owner.
     */
    match /assetVerifications/{verificationId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages asset check-in/check-out history.
     * @path /assetCheckouts/{checkoutId}
     * @allow (get, list) Any user can read asset check-in/check-out history.
     * @allow (create) User can create an asset checkout record if they are the owner.
     * @deny (create) User cannot create an asset checkout record if they are not the owner.
     * @allow (update, delete) Only the owner can update or delete an asset checkout record.
     * @deny (update, delete) Other users cannot update or delete the asset checkout record.
     * @principle Allows public read access but restricts writes to the owner.
     */
    match /assetCheckouts/{checkoutId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages records of scrapped assets.
     * @path /scrapRecords/{scrapId}
     * @allow (get, list) Any user can read scrap records.
     * @allow (create) User can create a scrap record if they are the owner.
     * @deny (create) User cannot create a scrap record if they are not the owner.
     * @allow (update, delete) Only the owner can update or delete a scrap record.
     * @deny (update, delete) Other users cannot update or delete the scrap record.
     * @principle Allows public read access but restricts writes to the owner.
     */
    match /scrapRecords/{scrapId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Manages feedback and issue logs for assets.
     * @path /assetFeedback/{feedbackId}
     * @allow (get, list) Any user can read asset feedback.
     * @allow (create) User can create asset feedback if they are the owner.
     * @deny (create) User cannot create asset feedback if they are not the owner.
     * @allow (update, delete) Only the owner can update or delete asset feedback.
     * @deny (update, delete) Other users cannot update or delete the asset feedback.
     * @principle Allows public read access but restricts writes to the owner.
     */
    match /assetFeedback/{feedbackId} {
      allow get, list: if true;
      allow create: if isSignedIn(); // TODO: Add owner validation once the schema is updated with an ownership field.
      allow update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    function isSignedIn() {
        return request.auth != null;
    }
  }
}