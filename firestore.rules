/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on user identity, enforcing strict
 * ownership for user profiles and allowing public read access to asset data.
 * Write access to assets and related collections (requests, transfers, verifications, etc.)
 * is restricted to authenticated users.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores individual user profiles.
 * - `/assets/{assetId}`: Stores master data for all assets.
 * - `/assetRequests/{requestId}`, `/assetTransfers/{transferId}`, `/assetVerifications/{verificationId}`,
 *   `/assetCheckouts/{checkoutId}`, `/scrapRecords/{scrapId}`, `/assetFeedback/{feedbackId}`:
 *   Store related records/logs for assets.
 *
 * Key Security Decisions:
 * - User profiles are private and accessible only to the owning user.
 * - Asset data is publicly readable, but writable only by authenticated users.
 * - Asset requests, transfers, verifications, and other related collections are writable by authenticated users.
 * - Listing of users is denied due to privacy concerns.
 *
 * Denormalization for Authorization:
 *  - The rules assume a general need to authorize writes based on the authenticated user.
 *  - No denormalization is explicitly mandated for this initial prototyping phase, but
 *    future iterations should consider denormalizing ownership/authorization data onto
 *    documents to avoid costly `get()` calls in rules.
 *
 * Structural Segregation:
 *  - No structural segregation is used. All data is stored in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles, allowing only the owner to read and write.
     * @path /users/{userId}
     * @allow (create, update, delete, get) User with UID 'userId' can manage their own profile.
     * @deny (create, update, delete, get) User with UID 'otherUserId' cannot manage 'userId' profile.
     * @deny list Users collection is not listable.
     * @principle Enforces user-ownership for profile data.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to assets, but restricts writes to authenticated users.
     * @path /assets/{assetId}
     * @allow (get, list) Any user can read asset data.
     * @allow (create, update, delete) Authenticated users can manage asset data.
     * @deny (create, update, delete) Unauthenticated users cannot manage asset data.
     * @principle Allows public read, restricts writes to authenticated users.
     */
    match /assets/{assetId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Restricts access to asset requests to authenticated users.
     * @path /assetRequests/{requestId}
     * @allow (create, update, delete) Authenticated users can manage asset requests.
     * @allow (get, list) Any user can read asset request data.
     * @deny (create, update, delete) Unauthenticated users cannot manage asset requests.
     * @principle Authenticated users only can manage asset requests.
     */
    match /assetRequests/{requestId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Restricts access to asset transfers to authenticated users.
     * @path /assetTransfers/{transferId}
     * @allow (create, update, delete) Authenticated users can manage asset transfers.
     * @allow (get, list) Any user can read asset transfer logs.
     * @deny (create, update, delete) Unauthenticated users cannot manage asset transfers.
     * @principle Authenticated users only can manage asset transfers.
     */
    match /assetTransfers/{transferId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Restricts access to asset verifications to authenticated users.
     * @path /assetVerifications/{verificationId}
     * @allow (create, update, delete) Authenticated users can manage asset verifications.
     * @allow (get, list) Any user can read asset verification logs.
     * @deny (create, update, delete) Unauthenticated users cannot manage asset verifications.
     * @principle Authenticated users only can manage asset verifications.
     */
    match /assetVerifications/{verificationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Restricts access to asset checkouts to authenticated users.
     * @path /assetCheckouts/{checkoutId}
     * @allow (create, update, delete) Authenticated users can manage asset checkouts.
     * @allow (get, list) Any user can read asset checkout logs.
     * @deny (create, update, delete) Unauthenticated users cannot manage asset checkouts.
     * @principle Authenticated users only can manage asset checkouts.
     */
    match /assetCheckouts/{checkoutId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Restricts access to scrap records to authenticated users.
     * @path /scrapRecords/{scrapId}
     * @allow (create, update, delete) Authenticated users can manage scrap records.
     * @allow (get, list) Any user can read scrap records.
     * @deny (create, update, delete) Unauthenticated users cannot manage scrap records.
     * @principle Authenticated users only can manage scrap records.
     */
    match /scrapRecords/{scrapId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    /**
     * @description Restricts access to asset feedback to authenticated users.
     * @path /assetFeedback/{feedbackId}
     * @allow (create, update, delete) Authenticated users can manage asset feedback.
     * @allow (get, list) Any user can read asset feedback.
     * @deny (create, update, delete) Unauthenticated users cannot manage asset feedback.
     * @principle Authenticated users only can manage asset feedback.
     */
    match /assetFeedback/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }
  }
}