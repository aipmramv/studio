/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles
 * and public read access with owner-only writes for assets and related collections.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only by the owning user.
 * - /assets/{assetId}: Stores asset data, publicly readable, but only writable by the owner (if ownership field exists in schema).
 * - /assetRequests/{requestId}: Stores asset ownership change requests, publicly readable, but only writable by the owner (if ownership field exists in schema).
 * - /assetTransfers/{transferId}: Stores asset transfer logs, publicly readable, but only writable by the owner (if ownership field exists in schema).
 * - /assetVerifications/{verificationId}: Stores asset verification history, publicly readable, but only writable by the owner (if ownership field exists in schema).
 * - /assetCheckouts/{checkoutId}: Stores asset checkout history, publicly readable, but only writable by the owner (if ownership field exists in schema).
 * - /scrapRecords/{scrapId}: Stores records of scrapped assets, publicly readable, but only writable by the owner (if ownership field exists in schema).
 * - /assetFeedback/{feedbackId}: Stores feedback and issue logs for assets, publicly readable, but only writable by the owner (if ownership field exists in schema).
 *
 * Key Security Decisions:
 * - User profiles are private and only accessible to the owning user.
 * - Assets and all related collections (requests, transfers, verifications, checkouts, scrap records, feedback) are publicly readable.
 * - Writes to assets and related collections are restricted to the owner, assuming an ownership field exists in the schema.
 * - Listing of users is denied to prevent information disclosure.
 *
 * Denormalization for Authorization:
 * - The rules assume that if owner-only writes are required, the documents contain an `ownerId` or `authorId` field that can be used to verify ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information. Only the user with the matching UID can read or write their profile.
     * @path /databases/{database}/documents/users/{userId}
     * @allow (get, create, update, delete) User with UID 'user123' can read/write their own profile document.
     * @deny (get, create, update, delete) User with UID 'user456' cannot read/write the profile document of user 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow update: if isSignedIn() && isOwner(userId) && request.resource.data.id == request.auth.uid;
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Controls access to asset master data. Allows public read access, but restricts writes to the owner (if ownership field exists).
     * @path /databases/{database}/documents/assets/{assetId}
     * @allow (get, list) Any user can read asset data.
     * @allow (create) User with UID 'user123' can create a new asset document if request.resource.data.ownerId == request.auth.uid.
     * @allow (update, delete) User with UID 'user123' can update/delete asset document where resource.data.ownerId == request.auth.uid.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete asset document where resource.data.ownerId != request.auth.uid.
     * @principle Allows public read access while enforcing owner-only writes (if schema supports it).
     */
    match /assets/{assetId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
       allow create, update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to asset ownership change requests. Allows public read access, but restricts writes to the owner (if ownership field exists).
     * @path /databases/{database}/documents/assetRequests/{requestId}
     * @allow (get, list) Any user can read asset request data.
     * @allow (create) User with UID 'user123' can create a new asset request document if request.resource.data.ownerId == request.auth.uid.
     * @allow (update, delete) User with UID 'user123' can update/delete asset request document where resource.data.ownerId == request.auth.uid.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete asset request document where resource.data.ownerId != request.auth.uid.
     * @principle Allows public read access while enforcing owner-only writes (if schema supports it).
     */
    match /assetRequests/{requestId} {
          function isSignedIn() {
            return request.auth != null;
          }
      allow get, list: if true;
       allow create, update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to asset transfer logs. Allows public read access, but restricts writes to the owner (if ownership field exists).
     * @path /databases/{database}/documents/assetTransfers/{transferId}
     * @allow (get, list) Any user can read asset transfer data.
     * @allow (create) User with UID 'user123' can create a new asset transfer document if request.resource.data.ownerId == request.auth.uid.
     * @allow (update, delete) User with UID 'user123' can update/delete asset transfer document where resource.data.ownerId == request.auth.uid.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete asset transfer document where resource.data.ownerId != request.auth.uid.
     * @principle Allows public read access while enforcing owner-only writes (if schema supports it).
     */
    match /assetTransfers/{transferId} {
          function isSignedIn() {
            return request.auth != null;
          }
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to asset verification history. Allows public read access, but restricts writes to the owner (if ownership field exists).
     * @path /databases/{database}/documents/assetVerifications/{verificationId}
     * @allow (get, list) Any user can read asset verification data.
     * @allow (create) User with UID 'user123' can create a new asset verification document if request.resource.data.ownerId == request.auth.uid.
     * @allow (update, delete) User with UID 'user123' can update/delete asset verification document where resource.data.ownerId == request.auth.uid.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete asset verification document where resource.data.ownerId != request.auth.uid.
     * @principle Allows public read access while enforcing owner-only writes (if schema supports it).
     */
    match /assetVerifications/{verificationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to asset check-in/check-out history. Allows public read access, but restricts writes to the owner (if ownership field exists).
     * @path /databases/{database}/documents/assetCheckouts/{checkoutId}
     * @allow (get, list) Any user can read asset checkout data.
     * @allow (create) User with UID 'user123' can create a new asset checkout document if request.resource.data.ownerId == request.auth.uid.
     * @allow (update, delete) User with UID 'user123' can update/delete asset checkout document where resource.data.ownerId == request.auth.uid.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete asset checkout document where resource.data.ownerId != request.auth.uid.
     * @principle Allows public read access while enforcing owner-only writes (if schema supports it).
     */
    match /assetCheckouts/{checkoutId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
       allow create, update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to records of scrapped assets. Allows public read access, but restricts writes to the owner (if ownership field exists).
     * @path /databases/{database}/documents/scrapRecords/{scrapId}
     * @allow (get, list) Any user can read scrap record data.
     * @allow (create) User with UID 'user123' can create a new scrap record document if request.resource.data.ownerId == request.auth.uid.
     * @allow (update, delete) User with UID 'user123' can update/delete scrap record document where resource.data.ownerId == request.auth.uid.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete scrap record document where resource.data.ownerId != request.auth.uid.
     * @principle Allows public read access while enforcing owner-only writes (if schema supports it).
     */
    match /scrapRecords/{scrapId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
      allow create, update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }

    /**
     * @description Controls access to asset feedback and issue logs. Allows public read access, but restricts writes to the owner (if ownership field exists).
     * @path /databases/{database}/documents/assetFeedback/{feedbackId}
     * @allow (get, list) Any user can read asset feedback data.
     * @allow (create) User with UID 'user123' can create a new asset feedback document if request.resource.data.ownerId == request.auth.uid.
     * @allow (update, delete) User with UID 'user123' can update/delete asset feedback document where resource.data.ownerId == request.auth.uid.
     * @deny (create, update, delete) User with UID 'user456' cannot create/update/delete asset feedback document where resource.data.ownerId != request.auth.uid.
     * @principle Allows public read access while enforcing owner-only writes (if schema supports it).
     */
    match /assetFeedback/{feedbackId} {
      function isSignedIn() {
        return request.auth != null;
      }
      allow get, list: if true;
       allow create, update, delete: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
    }
  }
}