/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles,
 * allowing each user to read and write their own profile data. Public read access is not granted.
 * For assets and related collections (requests, transfers, verifications, etc.),
 * write access is generally restricted, implying administrative control.  Data structure validation
 * is relaxed to facilitate rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only to the user themselves.
 * - /assets/{assetId}: Stores asset master data, with restricted write access.
 * - /assetRequests/{requestId}: Stores asset ownership change requests, with restricted write access.
 * - /assetTransfers/{transferId}: Stores asset transfer logs, with restricted write access.
 * - /assetVerifications/{verificationId}: Stores asset verification history, with restricted write access.
 * - /assetCheckouts/{checkoutId}: Stores asset check-in/check-out history, with restricted write access.
 * - /scrapRecords/{scrapId}: Stores records of scrapped assets, with restricted write access.
 * - /assetFeedback/{feedbackId}: Stores asset feedback and issue logs, with restricted write access.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied to protect user privacy.
 * - Write access to assets and related collections is restricted, assuming administrative functions.
 * - Data validation is minimized to focus on authorization during prototyping.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create a profile if request.auth.uid == 'user123'.
     * @allow (get, update, delete) - User with UID 'user123' can read/update/delete their own profile.
     * @deny (create) - User with UID 'user456' cannot create a profile for userId 'user123'.
     * @deny (get, update, delete) - User with UID 'user456' cannot read/update/delete the profile of userId 'user123'.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      // Function to check if the user is signed in
      function isSignedIn() {
        return request.auth != null;
      }

      // Function to check if the user is the owner of the document
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      // Function to check if the user is the owner of the existing document
      function isExistingOwner(userId) {
        return isOwner(userId) && resource.data != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Explicitly disallow listing of users

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id; //Immutable id
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to asset master data.
     * @path /assets/{assetId}
     * @allow (get, list) - Any user can read asset data.
     * @deny (create, update, delete) - Only admins can manage asset data (writes are disabled for non-admins).
     * @principle Restricts write access to asset data.
     */
    match /assets/{assetId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to asset ownership change requests.
     * @path /assetRequests/{requestId}
     * @allow (get, list) - Any user can read asset request data.
     * @deny (create, update, delete) - Only admins can manage asset request data (writes are disabled for non-admins).
     * @principle Restricts write access to asset request data.
     */
    match /assetRequests/{requestId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to asset transfer/movement logs.
     * @path /assetTransfers/{transferId}
     * @allow (get, list) - Any user can read asset transfer data.
     * @deny (create, update, delete) - Only admins can manage asset transfer data (writes are disabled for non-admins).
     * @principle Restricts write access to asset transfer data.
     */
    match /assetTransfers/{transferId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to asset verification history.
     * @path /assetVerifications/{verificationId}
     * @allow (get, list) - Any user can read asset verification data.
     * @deny (create, update, delete) - Only admins can manage asset verification data (writes are disabled for non-admins).
     * @principle Restricts write access to asset verification data.
     */
    match /assetVerifications/{verificationId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to asset check-in/check-out history.
     * @path /assetCheckouts/{checkoutId}
     * @allow (get, list) - Any user can read asset checkout data.
     * @deny (create, update, delete) - Only admins can manage asset checkout data (writes are disabled for non-admins).
     * @principle Restricts write access to asset checkout data.
     */
    match /assetCheckouts/{checkoutId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to scrapped asset records.
     * @path /scrapRecords/{scrapId}
     * @allow (get, list) - Any user can read scrap record data.
     * @deny (create, update, delete) - Only admins can manage scrap record data (writes are disabled for non-admins).
     * @principle Restricts write access to scrap record data.
     */
    match /scrapRecords/{scrapId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }

    /**
     * @description Controls access to asset feedback and issue logs.
     * @path /assetFeedback/{feedbackId}
     * @allow (get, list) - Any user can read asset feedback data.
     * @deny (create, update, delete) - Only admins can manage asset feedback data (writes are disabled for non-admins).
     * @principle Restricts write access to asset feedback data.
     */
    match /assetFeedback/{feedbackId} {
      allow get, list: if true;
      allow create, update, delete: if false;
    }
  }
}