/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles,
 * and public read access with owner-only writes for assets and asset-related
 * collections. This allows for a flexible data model while ensuring that
 * unauthorized users cannot modify or delete data they do not own.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores user profile information, accessible only to the
 *   user themselves.
 * - `/assets/{assetId}`: Stores asset data, publicly readable but only
 *   modifiable by an authenticated user who sets the `assetCoordinator` to their `uid`.
 * - `/assetRequests/{requestId}`, `/assetTransfers/{transferId}`, `/assetVerifications/{verificationId}`,
 *   `/assetCheckouts/{checkoutId}`, `/scrapRecords/{scrapId}`, `/assetFeedback/{feedbackId}`:
 *   Asset-related collections, publicly readable but only modifiable by an
 *   authenticated user who sets the `assetCoordinator` on the main `/assets/{assetId}` document
 *   to their `uid`.
 *
 * Key Security Decisions:
 * - User listing is disabled to protect user privacy.
 * - Read-only access is granted to the `/assets` collection to allow
 *   unauthenticated users to view asset data.
 * - All write operations require authentication and ownership validation.
 * - Data shape validation is relaxed to allow for rapid prototyping.
 *
 * Denormalization for Authorization:
 * The rules rely on the `assetCoordinator` field in the `/assets/{assetId}`
 * document to determine ownership for write operations on asset-related
 * collections. This avoids costly `get()` calls to other collections.
 *
 * Structural Segregation:
 * No structural segregation is used in this ruleset. All data is stored in
 * top-level collections with appropriate security rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user_abc' can create their own profile at /users/user_abc.
     * @allow (get,update,delete) User with UID 'user_abc' can read/update/delete their own profile at /users/user_abc.
     * @deny (create) User with UID 'user_xyz' cannot create a profile at /users/user_abc.
     * @deny (get,update,delete) User with UID 'user_xyz' cannot read/update/delete the profile at /users/user_abc.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to assets, but restricts writes to the assetCoordinator.
     * @path /assets/{assetId}
     * @allow (get,list) Any user (authenticated or not) can read asset data.
     * @allow (create) User with UID 'user_abc' can create an asset if they set assetCoordinator to their own UID.
     * @allow (update,delete) User with UID 'user_abc' can update/delete an asset if they are the assetCoordinator.
     * @deny (create) User with UID 'user_xyz' cannot create an asset with assetCoordinator set to 'user_abc'.
     * @deny (update,delete) User with UID 'user_xyz' cannot update/delete an asset if 'user_abc' is the assetCoordinator.
     * @principle Allows public read with owner-only writes, enforced via the `assetCoordinator` field.
     */
    match /assets/{assetId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(assetCoordinator) {
        return isSignedIn() && request.auth.uid == assetCoordinator;
      }

      function isExistingOwner(assetCoordinator) {
        return isOwner(assetCoordinator) && resource != null;
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && request.resource.data.assetCoordinator == request.auth.uid;
      allow update: if isExistingOwner(resource.data.assetCoordinator);
      allow delete: if isExistingOwner(resource.data.assetCoordinator);
    }

    /**
     * @description Allows public read access to asset requests, but restricts writes to the assetCoordinator of the main asset.
     * @path /assetRequests/{requestId}
     * @allow (get,list) Any user (authenticated or not) can read asset request data.
     * @allow (create,update,delete) User with UID 'user_abc' can create/update/delete an asset request if they are the assetCoordinator of the associated asset.
     * @deny (create,update,delete) User with UID 'user_xyz' cannot create/update/delete an asset request if 'user_abc' is the assetCoordinator of the associated asset.
     * @principle Allows public read with owner-only writes, enforced via the `assetCoordinator` field on the main asset.
     */
    match /assetRequests/{requestId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function getAssetCoordinator(assetId) {
        return get(/databases/$(database)/documents/assets/$(assetId)).data.assetCoordinator;
      }

      function isAssetCoordinator(assetId) {
          return isSignedIn() && request.auth.uid == getAssetCoordinator(assetId);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAssetCoordinator(request.resource.data.assets[0].assetId);
      allow update: if isSignedIn() && isAssetCoordinator(resource.data.assets[0].assetId);
      allow delete: if isSignedIn() && isAssetCoordinator(resource.data.assets[0].assetId) && resource != null;
    }

    /**
     * @description Allows public read access to asset transfers, but restricts writes to the assetCoordinator of the main asset.
     * @path /assetTransfers/{transferId}
     * @allow (get,list) Any user (authenticated or not) can read asset transfer data.
     * @allow (create,update,delete) User with UID 'user_abc' can create/update/delete an asset transfer if they are the assetCoordinator of the associated asset.
     * @deny (create,update,delete) User with UID 'user_xyz' cannot create/update/delete an asset transfer if 'user_abc' is the assetCoordinator of the associated asset.
     * @principle Allows public read with owner-only writes, enforced via the `assetCoordinator` field on the main asset.
     */
    match /assetTransfers/{transferId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getAssetCoordinator(assetId) {
        return get(/databases/$(database)/documents/assets/$(assetId)).data.assetCoordinator;
      }

      function isAssetCoordinator(assetId) {
          return isSignedIn() && request.auth.uid == getAssetCoordinator(assetId);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAssetCoordinator(request.resource.data.assetId);
      allow update: if isSignedIn() && isAssetCoordinator(resource.data.assetId);
      allow delete: if isSignedIn() && isAssetCoordinator(resource.data.assetId) && resource != null;
    }

    /**
     * @description Allows public read access to asset verifications, but restricts writes to the assetCoordinator of the main asset.
     * @path /assetVerifications/{verificationId}
     * @allow (get,list) Any user (authenticated or not) can read asset verification data.
     * @allow (create,update,delete) User with UID 'user_abc' can create/update/delete an asset verification if they are the assetCoordinator of the associated asset.
     * @deny (create,update,delete) User with UID 'user_xyz' cannot create/update/delete an asset verification if 'user_abc' is the assetCoordinator of the associated asset.
     * @principle Allows public read with owner-only writes, enforced via the `assetCoordinator` field on the main asset.
     */
    match /assetVerifications/{verificationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getAssetCoordinator(assetId) {
        return get(/databases/$(database)/documents/assets/$(assetId)).data.assetCoordinator;
      }

      function isAssetCoordinator(assetId) {
          return isSignedIn() && request.auth.uid == getAssetCoordinator(assetId);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAssetCoordinator(request.resource.data.assetId);
      allow update: if isSignedIn() && isAssetCoordinator(resource.data.assetId);
      allow delete: if isSignedIn() && isAssetCoordinator(resource.data.assetId) && resource != null;
    }

        /**
     * @description Allows public read access to asset checkouts, but restricts writes to the assetCoordinator of the main asset.
     * @path /assetCheckouts/{checkoutId}
     * @allow (get,list) Any user (authenticated or not) can read asset checkout data.
     * @allow (create,update,delete) User with UID 'user_abc' can create/update/delete an asset checkout if they are the assetCoordinator of the associated asset.
     * @deny (create,update,delete) User with UID 'user_xyz' cannot create/update/delete an asset checkout if 'user_abc' is the assetCoordinator of the associated asset.
     * @principle Allows public read with owner-only writes, enforced via the `assetCoordinator` field on the main asset.
     */
    match /assetCheckouts/{checkoutId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getAssetCoordinator(assetId) {
        return get(/databases/$(database)/documents/assets/$(assetId)).data.assetCoordinator;
      }

      function isAssetCoordinator(assetId) {
          return isSignedIn() && request.auth.uid == getAssetCoordinator(assetId);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAssetCoordinator(request.resource.data.assetId);
      allow update: if isSignedIn() && isAssetCoordinator(resource.data.assetId);
      allow delete: if isSignedIn() && isAssetCoordinator(resource.data.assetId) && resource != null;
    }

    /**
     * @description Allows public read access to scrap records, but restricts writes to the assetCoordinator of the main asset.
     * @path /scrapRecords/{scrapId}
     * @allow (get,list) Any user (authenticated or not) can read scrap record data.
     * @allow (create,update,delete) User with UID 'user_abc' can create/update/delete a scrap record if they are the assetCoordinator of the associated asset.
     * @deny (create,update,delete) User with UID 'user_xyz' cannot create/update/delete a scrap record if 'user_abc' is the assetCoordinator of the associated asset.
     * @principle Allows public read with owner-only writes, enforced via the `assetCoordinator` field on the main asset.
     */
    match /scrapRecords/{scrapId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function getAssetCoordinator(assetId) {
        return get(/databases/$(database)/documents/assets/$(assetId)).data.assetCoordinator;
      }

      function isAssetCoordinator(assetId) {
          return isSignedIn() && request.auth.uid == getAssetCoordinator(assetId);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAssetCoordinator(request.resource.data.assetId);
      allow update: if isSignedIn() && isAssetCoordinator(resource.data.assetId);
      allow delete: if isSignedIn() && isAssetCoordinator(resource.data.assetId) && resource != null;
    }

   /**
     * @description Allows public read access to asset feedback, but restricts writes to the assetCoordinator of the main asset.
     * @path /assetFeedback/{feedbackId}
     * @allow (get,list) Any user (authenticated or not) can read asset feedback data.
     * @allow (create,update,delete) User with UID 'user_abc' can create/update/delete asset feedback if they are the assetCoordinator of the associated asset.
     * @deny (create,update,delete) User with UID 'user_xyz' cannot create/update/delete asset feedback if 'user_abc' is the assetCoordinator of the associated asset.
     * @principle Allows public read with owner-only writes, enforced via the `assetCoordinator` field on the main asset.
     */
    match /assetFeedback/{feedbackId} {
       function isSignedIn() {
        return request.auth != null;
      }

      function getAssetCoordinator(assetId) {
        return get(/databases/$(database)/documents/assets/$(assetId)).data.assetCoordinator;
      }

      function isAssetCoordinator(assetId) {
          return isSignedIn() && request.auth.uid == getAssetCoordinator(assetId);
      }

      allow get: if true;
      allow list: if true;
      allow create: if isSignedIn() && isAssetCoordinator(request.resource.data.assetId);
      allow update: if isSignedIn() && isAssetCoordinator(resource.data.assetId);
      allow delete: if isSignedIn() && isAssetCoordinator(resource.data.assetId) && resource != null;
    }
  }
}