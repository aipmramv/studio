/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System
 *
 * Core Philosophy:
 * This ruleset prioritizes a secure, owner-centric access control model.
 * Users have full control over their profiles, while asset data is broadly readable but
 * write-protected, requiring authentication for modifications.  In the initial
 * prototyping phase, complex schema validation and data-type enforcement are relaxed
 * to enable rapid development iteration.  The rules focus on identity and authorization.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`, accessible only by the owning user.
 * - Assets are stored under `/assets/{assetId}`, with public read access. Write access requires authentication.
 * - Asset requests are stored under `/assetRequests/{requestId}`, write access is denied.
 * - Asset transfers are stored under `/assetTransfers/{transferId}`, write access is denied.
 * - Asset verifications are stored under `/assetVerifications/{verificationId}`, write access is denied.
 * - Asset checkouts are stored under `/assetCheckouts/{checkoutId}`, write access is denied.
 * - Scrap records are stored under `/scrapRecords/{scrapId}`, write access is denied.
 * - Asset feedback is stored under `/assetFeedback/{feedbackId}`, write access is denied.
 *
 * Key Security Decisions:
 * - **No User Listing**: Listing all user profiles is explicitly denied to prevent information harvesting.
 * - **Public Asset Reads**: Assets are publicly readable to facilitate easy access to asset information.
 * - **Authenticated Asset Writes**: Creating, updating, or deleting assets requires authentication.
 * - **Data Denormalization**: Currently not implemented. However, for more complex authorization scenarios,
 *   consider denormalizing authorization-relevant data (e.g., asset ownership) directly onto documents
 *   to avoid expensive `get()` calls in security rules.
 * - **Asset Requests**:  Creating, updating, or deleting asset requests requires authentication.
 * - **Asset Transfers**: Creating, updating, or deleting asset transfers requires authentication.
 * - **Asset Verifications**: Creating, updating, or deleting asset verifications requires authentication.
 * - **Asset Checkouts**: Creating, updating, or deleting asset checkouts requires authentication.
 * - **Scrap Records**: Creating, updating, or deleting scrap records requires authentication.
 * - **Asset Feedback**: Creating, updating, or deleting asset feedback requires authentication.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create a profile at /users/user123.
     * @allow (get, list) - User with UID 'user123' can read their profile at /users/user123.
     * @allow (update, delete) - User with UID 'user123' can update/delete their profile at /users/user123.
     * @deny (create) - User with UID 'user456' cannot create a profile at /users/user123.
     * @deny (get, list) - User with UID 'user456' cannot read user123's profile at /users/user123.
     * @deny (update, delete) - User with UID 'user456' cannot update/delete user123's profile at /users/user123.
     * @principle Enforces document ownership, restricting access to the owning user.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Explicitly disallow listing all users

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == request.resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to asset data.
     * @path /assets/{assetId}
     * @allow (get, list) - Any user (signed in or not) can read asset data.
     * @allow (create, update, delete) - User must be signed in to modify asset data.
     * @deny (create, update, delete) - Unauthenticated users cannot modify asset data.
     * @principle Allows public read access while restricting write access to authenticated users.
     */
    match /assets/{assetId} {
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

     /**
      * @description Controls access to asset requests.
      * @path /assetRequests/{requestId}
      * @allow (create) - Any signed in user can create asset requests.
      * @deny (get, list, update, delete) - Nobody can get, list, update, or delete asset requests.
      */
     match /assetRequests/{requestId} {
       allow get, list, update, delete: if false;
       allow create: if isSignedIn();
     }

    /**
     * @description Controls access to asset transfers.
     * @path /assetTransfers/{transferId}
     * @allow (create) - Any signed in user can create asset transfers.
     * @deny (get, list, update, delete) - Nobody can get, list, update, or delete asset transfers.
     */
    match /assetTransfers/{transferId} {
      allow get, list, update, delete: if false;
      allow create: if isSignedIn();
    }

    /**
     * @description Controls access to asset verifications.
     * @path /assetVerifications/{verificationId}
     * @allow (create) - Any signed in user can create asset verifications.
     * @deny (get, list, update, delete) - Nobody can get, list, update, or delete asset verifications.
     */
    match /assetVerifications/{verificationId} {
      allow get, list, update, delete: if false;
      allow create: if isSignedIn();
    }

    /**
     * @description Controls access to asset checkouts.
     * @path /assetCheckouts/{checkoutId}
     * @allow (create) - Any signed in user can create asset checkouts.
     * @deny (get, list, update, delete) - Nobody can get, list, update, or delete asset checkouts.
     */
    match /assetCheckouts/{checkoutId} {
      allow get, list, update, delete: if false;
      allow create: if isSignedIn();
    }

    /**
     * @description Controls access to scrap records.
     * @path /scrapRecords/{scrapId}
     * @allow (create) - Any signed in user can create scrap records.
     * @deny (get, list, update, delete) - Nobody can get, list, update, or delete scrap records.
     */
    match /scrapRecords/{scrapId} {
      allow get, list, update, delete: if false;
      allow create: if isSignedIn();
    }

    /**
     * @description Controls access to asset feedback.
     * @path /assetFeedback/{feedbackId}
     * @allow (create) - Any signed in user can create asset feedback.
     * @deny (get, list, update, delete) - Nobody can get, list, update, or delete asset feedback.
     */
    match /assetFeedback/{feedbackId} {
      allow get, list, update, delete: if false;
      allow create: if isSignedIn();
    }

  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}