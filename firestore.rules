/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on user roles and ownership.
 * It aims to prevent unauthorized data modification and exposure while allowing
 * for flexible data shapes during the prototyping phase.
 *
 * Data Structure:
 * - /users/{userId}: Stores individual user profiles, accessible only to the user themselves.
 * - /assets/{assetId}: Stores asset details. Read access is public, while write access is restricted to owners.
 * - /assetRequests/{requestId}: Stores asset requests.
 * - /assetTransfers/{transferId}: Stores asset transfer records.
 * - /assetVerifications/{verificationId}: Stores asset verification records.
 * - /assetCheckouts/{checkoutId}: Stores asset check-out records.
 * - /scrapRecords/{scrapId}: Stores asset scrap records.
 * - /assetFeedback/{feedbackId}: Stores asset feedback records.
 *
 * Key Security Decisions:
 * - User profiles are strictly private and accessible only to the owning user.
 * - Listing of users is disallowed.
 * - Public read access is granted for asset data, but writes require ownership.
 * - No role based access control is implemented.
 *
 * Denormalization for Authorization:
 *  No explicit denormalization strategy is implemented.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces access control for user profiles.
     * @path /users/{userId}
     * @allow (create) - If the user's ID matches the userId in the path.
     * @allow (get, update, delete) - If the user is the owner of the profile.
     * @deny (create) - If the user's ID does not match the userId in the path.
     * @deny (get, update, delete) - If the user is not the owner of the profile.
     * @principle Enforces document ownership for writes and restricts access to a user's own data tree.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if request.auth.uid == userId;
      allow update: if isOwner(userId) ;
      allow delete: if isOwner(userId) ;
    }

    /**
     * @description Grants public read access to assets, but restricts write access to owners.
     * @path /assets/{assetId}
     * @allow (get, list) - Everyone can read the assets.
     * @allow (create) - Only if the request data has `assetId` == `request.auth.uid`.
     * @allow (update, delete) - Only the owner of the asset can modify or delete it, and only if the document exists.
     * @deny (create) - If the request data does not have `assetId` == `request.auth.uid`.
     * @deny (update, delete) - If the user is not the owner of the asset or the document doesn't exist.
     * @principle Grants public read with owner-only writes, and validates relational integrity on create.
     */
    match /assets/{assetId} {
      function isOwner() {
        return request.auth != null && resource.data.ownerUid == request.auth.uid;
      }
      allow get, list: if true;
      allow create: if request.auth != null;
      allow update: if isOwner();
      allow delete: if isOwner();
    }

      /**
       * @description Controls access to asset requests.
       * @path /assetRequests/{requestId}
       * @allow (get, list) - Everyone can read the asset requests.
       * @allow (create) - Only authenticated users can create requests.
       * @allow (update, delete) - Only the user who created the request can modify or delete it.
       * @deny (create) - If not authenticated.
       * @deny (update, delete) - If the request does not exist or if the user is not the request creator.
       * @principle Enforces authentication for creation and ownership for modifications.
       */
      match /assetRequests/{requestId} {
        function isOwner() {
          return request.auth != null && resource.data.requestorUid == request.auth.uid;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if isOwner();
        allow delete: if isOwner();
    }

    /**
     * @description Controls access to asset transfers.
     * @path /assetTransfers/{transferId}
     * @allow (get, list) - Everyone can read transfer records.
     * @allow (create) - Only authenticated users can create transfer records.
     * @allow (update, delete) - Only the user who created the transfer record can modify or delete it.
     * @deny (create) - If not authenticated.
     * @deny (update, delete) - If the request does not exist or if the user is not the record creator.
     * @principle Enforces authentication for creation and ownership for modifications.
     */
    match /assetTransfers/{transferId} {
        function isOwner() {
          return request.auth != null && resource.data.creatorUid == request.auth.uid;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if isOwner();
        allow delete: if isOwner();
    }

    /**
     * @description Controls access to asset verifications.
     * @path /assetVerifications/{verificationId}
     * @allow (get, list) - Everyone can read verification records.
     * @allow (create) - Only authenticated users can create verification records.
     * @allow (update, delete) - Only the user who created the verification record can modify or delete it.
     * @deny (create) - If not authenticated.
     * @deny (update, delete) - If the request does not exist or if the user is not the record creator.
     * @principle Enforces authentication for creation and ownership for modifications.
     */
    match /assetVerifications/{verificationId} {
        function isOwner() {
          return request.auth != null && resource.data.creatorUid == request.auth.uid;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if isOwner();
        allow delete: if isOwner();
    }

    /**
     * @description Controls access to asset checkouts.
     * @path /assetCheckouts/{checkoutId}
     * @allow (get, list) - Everyone can read checkout records.
     * @allow (create) - Only authenticated users can create checkout records.
     * @allow (update, delete) - Only the user who created the checkout record can modify or delete it.
     * @deny (create) - If not authenticated.
     * @deny (update, delete) - If the request does not exist or if the user is not the record creator.
     * @principle Enforces authentication for creation and ownership for modifications.
     */
    match /assetCheckouts/{checkoutId} {
        function isOwner() {
          return request.auth != null && resource.data.creatorUid == request.auth.uid;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if isOwner();
        allow delete: if isOwner();
    }

    /**
     * @description Controls access to scrap records.
     * @path /scrapRecords/{scrapId}
     * @allow (get, list) - Everyone can read scrap records.
     * @allow (create) - Only authenticated users can create scrap records.
     * @allow (update, delete) - Only the user who created the scrap record can modify or delete it.
     * @deny (create) - If not authenticated.
     * @deny (update, delete) - If the request does not exist or if the user is not the record creator.
     * @principle Enforces authentication for creation and ownership for modifications.
     */
    match /scrapRecords/{scrapId} {
        function isOwner() {
          return request.auth != null && resource.data.creatorUid == request.auth.uid;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if isOwner();
        allow delete: if isOwner();
    }

    /**
     * @description Controls access to asset feedback.
     * @path /assetFeedback/{feedbackId}
     * @allow (get, list) - Everyone can read feedback records.
     * @allow (create) - Only authenticated users can create feedback records.
     * @allow (update, delete) - Only the user who created the feedback record can modify or delete it.
     * @deny (create) - If not authenticated.
     * @deny (update, delete) - If the request does not exist or if the user is not the record creator.
     * @principle Enforces authentication for creation and ownership for modifications.
     */
    match /assetFeedback/{feedbackId} {
        function isOwner() {
          return request.auth != null && resource.data.creatorUid == request.auth.uid;
        }
        function isSignedIn() {
          return request.auth != null;
        }
        allow get, list: if true;
        allow create: if isSignedIn();
        allow update: if isOwner();
        allow delete: if isOwner();
    }
  }
}