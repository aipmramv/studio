/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System
 *
 * Core Philosophy:
 * This ruleset prioritizes secure data access based on user identity and explicit authorization.
 * It enforces ownership for user profiles and allows public read access to asset-related data
 * while restricting write access to prevent unauthorized modifications.
 *
 * Data Structure:
 * - User profiles are stored under `/users/{userId}`, accessible only by the owning user.
 * - Asset master data, requests, transfers, verifications, checkouts, scrap records, and feedback
 *   are stored in top-level collections (`/assets`, `/assetRequests`, etc.).  These collections
 *   are publicly readable but writes are restricted.
 *
 * Key Security Decisions:
 * - User listing is explicitly denied.
 * - Asset-related collections are publicly readable to facilitate broad access to asset information,
 *   but write access is restricted to prevent unauthorized modification.  If finer-grained access
 *   control is needed for these collections, the rules must be updated accordingly.
 *
 * Denormalization for Authorization:
 * - The rules rely on the authenticated user's UID (`request.auth.uid`) to control access.
 *   For user-owned documents, the UID is compared to the document ID (`userId`) to enforce
 *   ownership.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by a signed-in user.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the authenticated user's UID matches the provided userId.
     */
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    /**
     * @description Checks if the authenticated user's UID matches the userId and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Enforces document ownership for writes.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' creates a profile at /users/user123
     * @deny (create) User with UID 'user123' attempts to create a profile at /users/user456
     * @principle Enforces document ownership for writes
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows public read access to asset master data. Write access is not explicitly defined and defaults to none (closed).
     * @path /assets/{assetId}
     * @allow (get) Any user can retrieve an asset.
     * @allow (list) Any user can list assets.
     * @deny (create) No user can create assets through these rules without additional conditions.
     * @principle Allows public read, restricts write access.
     */
    match /assets/{assetId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

      /**
       * @description Allows public read access to asset ownership change requests. Write access is not explicitly defined and defaults to none (closed).
       * @path /assetRequests/{requestId}
       * @allow (get) Any user can retrieve an asset request.
       * @allow (list) Any user can list asset requests. The fix was to allow listing.
       * @deny (create) No user can create asset requests through these rules without additional conditions.
       * @principle Allows public read, restricts write access.
       */
      match /assetRequests/{requestId} {
        allow get, list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
      }

    /**
     * @description Allows public read access to asset transfer logs. Write access is not explicitly defined and defaults to none (closed).
     * @path /assetTransfers/{transferId}
     * @allow (get) Any user can retrieve an asset transfer log.
     * @allow (list) Any user can list asset transfer logs.
     * @deny (create) No user can create asset transfer logs through these rules without additional conditions.
     * @principle Allows public read, restricts write access.
     */
    match /assetTransfers/{transferId} {
        allow get, list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read access to asset verification history. Write access is not explicitly defined and defaults to none (closed).
     * @path /assetVerifications/{verificationId}
     * @allow (get) Any user can retrieve an asset verification record.
     * @allow (list) Any user can list asset verification records.
     * @deny (create) No user can create asset verification records through these rules without additional conditions.
     * @principle Allows public read, restricts write access.
     */
    match /assetVerifications/{verificationId} {
        allow get, list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

       /**
        * @description Allows public read access to asset check-in/check-out history. Write access is not explicitly defined and defaults to none (closed).
        * @path /assetCheckouts/{checkoutId}
        * @allow (get) Any user can retrieve an asset checkout record.
        * @allow (list) Any user can list asset checkout records.
        * @deny (create) No user can create asset checkout records through these rules without additional conditions.
        * @principle Allows public read, restricts write access.
        */
    match /assetCheckouts/{checkoutId} {
        allow get, list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read access to records of scrapped assets. Write access is not explicitly defined and defaults to none (closed).
     * @path /scrapRecords/{scrapId}
     * @allow (get) Any user can retrieve a scrap record.
     * @allow (list) Any user can list scrap records.
     * @deny (create) No user can create scrap records through these rules without additional conditions.
     * @principle Allows public read, restricts write access.
     */
    match /scrapRecords/{scrapId} {
        allow get, list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Allows public read access to feedback and issue logs for assets. Write access is not explicitly defined and defaults to none (closed).
     * @path /assetFeedback/{feedbackId}
     * @allow (get) Any user can retrieve asset feedback.
     * @allow (list) Any user can list asset feedback.
     * @deny (create) No user can create asset feedback through these rules without additional conditions.
     * @principle Allows public read, restricts write access.
     */
    match /assetFeedback/{feedbackId} {
        allow get, list: if true;
        allow create, update, delete: if false; // TODO: Add owner validation once the schema is updated with an ownership field.
    }
  }
}