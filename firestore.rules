/**
 * @fileoverview Firestore Security Rules for TrackFlow Asset Management System
 *
 * Core Philosophy:
 * This ruleset prioritizes strong authorization based on user identity and resource ownership.
 * It provides basic security for prototyping, focusing on preventing unauthorized access
 * while remaining flexible on data shapes to allow for rapid schema iteration.
 *
 * Data Structure:
 * - `/users/{userId}`: Stores individual user profiles.
 * - `/assets/{assetId}`: Stores asset details.
 * - `/assetRequests/{requestId}`: Stores requests for asset changes.
 * - `/assetTransfers/{transferId}`: Stores asset transfer records.
 * - `/assetVerifications/{verificationId}`: Stores asset verification logs.
 * - `/assetCheckouts/{checkoutId}`: Stores asset checkout logs.
 * - `/scrapRecords/{scrapId}`: Stores records of scrapped assets.
 * - `/assetFeedback/{feedbackId}`: Stores feedback on assets.
 *
 * Key Security Decisions:
 * - Users can only read/write their own user profiles.
 * - Listing of the `/users` collection is disallowed to prevent information disclosure.
 * - All other collections are publicly readable, but writes are restricted.
 * - For write operations, the rules enforce that the authenticated user's ID matches
 *   an expected `ownerId` or `creatorId` field within the document to maintain data integrity.
 * - Data validation is limited to essential authorization and relational integrity checks.
 * - Existence checks are enforced for all update and delete operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their own profile at /users/user123.
     * @deny (create) - User with UID 'user123' cannot create a profile at /users/user456.
     * @allow (get, update, delete) - User with UID 'user123' can read, update, and delete their own profile at /users/user123.
     * @deny (get, update, delete) - User with UID 'user123' cannot read, update, or delete the profile of another user at /users/user456.
     * @principle Enforces document ownership for writes; restricts access to a user's own data tree.
     */
    match /users/{userId} {
      // Verified Identity: All authorization decisions must rely on `request.auth` as the source of truth.
      function isSignedIn() {
        return request.auth != null;
      }
      // Ownership: Use for paths like `/users/{userId}/...`. The primary helper function here should be `isOwner(userId)`.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
        // Auditable and Maintainable Logic: Abstract all complex logic into well-named helper functions.
        function isExistingOwner(userId) {
            return (isOwner(userId) && exists(/databases/$(database)/documents/users/$(userId)));
        }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isOwner(userId) && request.auth.uid == userId;
      allow update: if isExistingOwner(userId) && request.auth.uid == userId;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to asset master data.
     * @path /assets/{assetId}
     * @allow (get, list) - Any user can read asset information.
     * @deny (create, update, delete) - Only the owner can modify asset information.
     * @principle Public read access with owner-only writes, enforces document ownership for writes.
     */
    match /assets/{assetId} {
       // Ownership: Use for paths like `/users/{userId}/...`. The primary helper function here should be `isOwner(userId)`.
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      // Auditable and Maintainable Logic: Abstract all complex logic into well-named helper functions.
      function isExistingOwner(ownerId, assetId) {
          return (isOwner(ownerId) && exists(/databases/$(database)/documents/assets/$(assetId)));
      }

      allow get, list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingOwner(request.resource.data.personResponsible, assetId);
      allow delete: if isSignedIn() && isExistingOwner(request.resource.data.personResponsible, assetId);
    }

     /**
      * @description Controls access to asset request data.
      * @path /assetRequests/{requestId}
      * @allow (get, list) - Any user can read asset request information.
      * @deny (create, update, delete) - Only the owner can modify asset request information.
      * @principle Public read access with owner-only writes, enforces document ownership for writes.
      */
    match /assetRequests/{requestId} {

      // Ownership: Use for paths like `/users/{userId}/...`. The primary helper function here should be `isOwner(ownerId)`.
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }
      // Auditable and Maintainable Logic: Abstract all complex logic into well-named helper functions.
      function isExistingOwner(ownerId, requestId) {
          return (isOwner(ownerId) && exists(/databases/$(database)/documents/assetRequests/$(requestId)));
      }

      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingOwner(request.resource.data.requestedBy, requestId);
      allow delete: if isSignedIn() && isExistingOwner(request.resource.data.requestedBy, requestId);
    }

     /**
      * @description Controls access to asset transfer data.
      * @path /assetTransfers/{transferId}
      * @allow (get, list) - Any user can read asset transfer information.
      * @deny (create, update, delete) - Only the owner can modify asset transfer information.
      * @principle Public read access with owner-only writes, enforces document ownership for writes.
      */
    match /assetTransfers/{transferId} {

      // Ownership: Use for paths like `/users/{userId}/...`. The primary helper function here should be `isOwner(ownerId)`.
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      // Auditable and Maintainable Logic: Abstract all complex logic into well-named helper functions.
      function isExistingOwner(ownerId, transferId) {
          return (isOwner(ownerId) && exists(/databases/$(database)/documents/assetTransfers/$(transferId)));
      }

      allow get, list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingOwner(request.resource.data.responsiblePerson, transferId);
      allow delete: if isSignedIn() && isExistingOwner(request.resource.data.responsiblePerson, transferId);
    }

    /**
     * @description Controls access to asset verification data.
     * @path /assetVerifications/{verificationId}
     * @allow (get, list) - Any user can read asset verification information.
     * @deny (create, update, delete) - Only the owner can modify asset verification information.
     * @principle Public read access with owner-only writes, enforces document ownership for writes.
     */
    match /assetVerifications/{verificationId} {

      // Ownership: Use for paths like `/users/{userId}/...`. The primary helper function here should be `isOwner(ownerId)`.
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      // Auditable and Maintainable Logic: Abstract all complex logic into well-named helper functions.
      function isExistingOwner(ownerId, verificationId) {
          return (isOwner(ownerId) && exists(/databases/$(database)/documents/assetVerifications/$(verificationId)));
      }

      allow get, list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingOwner(request.resource.data.verifiedBy, verificationId);
      allow delete: if isSignedIn() && isExistingOwner(request.resource.data.verifiedBy, verificationId);
    }

    /**
     * @description Controls access to asset checkout data.
     * @path /assetCheckouts/{checkoutId}
     * @allow (get, list) - Any user can read asset checkout information.
     * @deny (create, update, delete) - Only the owner can modify asset checkout information.
     * @principle Public read access with owner-only writes, enforces document ownership for writes.
     */
    match /assetCheckouts/{checkoutId} {

      // Ownership: Use for paths like `/users/{userId}/...`. The primary helper function here should be `isOwner(ownerId)`.
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }
     // Auditable and Maintainable Logic: Abstract all complex logic into well-named helper functions.
      function isExistingOwner(ownerId, checkoutId) {
          return (isOwner(ownerId) && exists(/databases/$(database)/documents/assetCheckouts/$(checkoutId)));
      }

      allow get, list: if true;

      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingOwner(request.resource.data.custodian, checkoutId);
      allow delete: if isSignedIn() && isExistingOwner(request.resource.data.custodian, checkoutId);
    }

    /**
     * @description Controls access to scrap record data.
     * @path /scrapRecords/{scrapId}
     * @allow (get, list) - Any user can read scrap record information.
     * @deny (create, update, delete) - Only the owner can modify scrap record information.
     * @principle Public read access with owner-only writes, enforces document ownership for writes.
     */
    match /scrapRecords/{scrapId} {

      // Ownership: Use for paths like `/users/{userId}/...`. The primary helper function here should be `isOwner(ownerId)`.
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      // Auditable and Maintainable Logic: Abstract all complex logic into well-named helper functions.
      function isExistingOwner(ownerId, scrapId) {
          return (isOwner(ownerId) && exists(/databases/$(database)/documents/scrapRecords/$(scrapId)));
      }

      allow get, list: if true;

      allow create: if isSignedIn();
      allow update: if false;  // TODO: Add owner validation once the schema is updated with an ownership field.
      allow delete: if false;  // TODO: Add owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to asset feedback data.
     * @path /assetFeedback/{feedbackId}
     * @allow (get, list) - Any user can read asset feedback information.
     * @deny (create, update, delete) - Only the owner can modify asset feedback information.
     * @principle Public read access with owner-only writes, enforces document ownership for writes.
     */
    match /assetFeedback/{feedbackId} {
     // Ownership: Use for paths like `/users/{userId}/...`. The primary helper function here should be `isOwner(ownerId)`.
      function isOwner(ownerId) {
        return request.auth.uid == ownerId;
      }

      // Auditable and Maintainable Logic: Abstract all complex logic into well-named helper functions.
      function isExistingOwner(ownerId, feedbackId) {
          return (isOwner(ownerId) && exists(/databases/$(database)/documents/assetFeedback/$(feedbackId)));
      }
      allow get, list: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && isExistingOwner(request.resource.data.submittedBy, feedbackId);
      allow delete: if isSignedIn() && isExistingOwner(request.resource.data.submittedBy, feedbackId);
    }
  }
}